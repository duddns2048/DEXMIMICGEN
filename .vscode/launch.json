{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Train BC-RNN",
        "type": "python",
        "request": "launch",
        "program": "${workspaceFolder}/robomimic/robomimic/scripts/train.py",
        "args": [
          "--config","${workspaceFolder}/dexmimicgen/datasets/train_configs/bcrnn_action_dict/bc_rnn_image_ds_two_arm_pouring_humanoid_D0_seed_201_debug.json",
          "--name", "tmptmptmp",
          "--debug"

        ],
        "console": "integratedTerminal",
        "justMyCode": false,
        "cwd": "${workspaceFolder}/robomimic/robomimic",
        "env": {
          "CUDA_VISIBLE_DEVICES": "1",
          "MUJOCO_GL": "egl"
        }
      },
      {
        "name": "Run Trained Agent",
        "type": "python",
        "request": "launch",
        "program": "${workspaceFolder}/robomimic/robomimic/scripts/run_trained_agent.py",
        "console": "integratedTerminal",
        "justMyCode": false,
        "args": [
          "--agent", "${workspaceFolder}/dexmimicgen/datasets/training_results/bcrnn_action_dict/DESKTOP_pouring_201_base/20260528022941/models/model_epoch_600.pth",
          "--n_rollouts", "50",
          "--horizon", "400",
          "--seed", "0",
          "--logdir", "${workspaceFolder}/dexmimicgen/datasets/training_results/bcrnn_action_dict/DESKTOP_pouring_201_base/20260528022941/eval/epoch_600"
        ],
        "env": {
          "MUJOCO_GL": "egl"
        }
      }
    ]
  }